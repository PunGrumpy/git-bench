{
  "name": "git-bench-monorepo",
  "version": "0.1.0",
  "private": true,
  "workspaces": [
    "apps/*",
    "packages/*"
  ],
  "type": "module",
  "scripts": {
    "dev": "turbo run dev",
    "build": "turbo run build",
    "start": "turbo run start",
    "typecheck": "turbo run typecheck",
    "test": "turbo run test",
    "check": "ultracite check",
    "fix": "ultracite fix",
    "bench": "bash scripts/docker-bench.sh",
    "bench:build": "docker build -t git-bench .",
    "doctor": "bunx react-doctor@latest",
    "prepare": "husky"
  },
  "devDependencies": {
    "@typescript/native-preview": "^7.0.0-dev.20260606.1",
    "husky": "^9.1.7",
    "oxfmt": "^0.53.0",
    "oxlint": "^1.68.0",
    "react-doctor": "^0.4.0",
    "turbo": "^2.0.4",
    "ultracite": "7.8.1"
  },
  "packageManager": "bun@1.3.12"
}
